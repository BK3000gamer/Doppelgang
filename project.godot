config_version=5

[application]

config/name="Dopplegang"
run/main_scene="uid://b0u0ioleal0rf"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

ControllerMap="*uid://boytd2t4k8oy6"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/mode=3
window/stretch/mode="viewport"
window/stretch/aspect="expand"

[file_customization]

folder_colors={
"res://Entity/": "red",
"res://Environment/": "blue",
"res://Levels/": "orange",
"res://UI/": "green"
}

